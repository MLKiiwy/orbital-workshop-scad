// LEGO DUPLO bakfiets — DUPLO-compatible Dutch cargo bike: frame, cargo box, rain tent and wheels
// SPDX-License-Identifier: CC-BY-NC-SA-4.0
// =====================================================================
//  A DUPLO-scale "bakfiets" (Dutch front-loader cargo bike), styled after
//  a Dolly: long low frame, tall flared cargo box between the wheels,
//  removable rain tent on top.
//
//  5 printed pieces from 4 models:
//    frame  x1   cargo box x1   rain tent x1   wheel x2
//
//  DUPLO interfaces (generated by LEGO.scad, never hand-rolled):
//    - frame deck : 2x2 studs up          -> the cargo box clicks on
//    - box floor  : 2x2 plate, open bottom -> sockets down onto the deck,
//                   studs up INSIDE the box so a figure or brick clicks in
//
//  Coordinate system (origin = rear axle centre, projected to the ground):
//    +X : rear -> front
//    +Y : left -> right
//    +Z : ground -> up
//
//  Units: millimetres. Angles: degrees.
//
//  Export:  ./scripts/export.sh projects/lego-duplo-bakfiets/lego-duplo-bakfiets.scad 3mf
//           ./scripts/export.sh projects/lego-duplo-bakfiets/lego-duplo-bakfiets.scad stl -D 'part="frame"'
//  Check:   set part = "assembled" in the GUI to eyeball the whole bike.
//
//  No MakerWorld copy: LEGO.scad is not one of the libraries bundled by
//  MakerWorld's Parametric Model Maker, so scripts/makerworld.py refuses it.
// =====================================================================

include <../../libs/BOSL2/std.scad>
use <../../libs/LEGO.scad/LEGO.scad>

/* [Part] */
// Which piece to render. "plate" lays every piece out flat in print orientation; "assembled" is the show-off view.
part = "plate"; // [plate:Print plate (all pieces), assembled:Assembled bike, frame:Frame, box:Cargo box, tent:Rain tent, wheel:Wheel (print 2x)]

/* [Quality] */
// Facets for curved surfaces in preview (higher = smoother, slower)
fn_preview = 48;  // [24:8:128]
// Facets for curved surfaces in the final render/export
fn_render  = 128; // [64:8:256]

/* [Bike] */
// Distance from rear axle to front axle, mm
wheelbase        = 128; // [80:1:140]
// Gap between the underside of the frame and the ground, mm
ground_clearance = 4;   // [2:0.5:10]
// Width of the main frame beam (Y), mm
beam_w     = 20;        // [10:1:28]
// X position of the centre of the 2x2 cargo-box mounting deck, mm
deck_x     = 70;        // [40:1:80]
// X position of the handlebar, mm
bar_x      = 43;        // [20:1:50]
// Height of the handlebar above the ground, mm
bar_z      = 52;        // [35:1:70]
// Total handlebar width, mm. Roughly the width of the cargo box.
bar_w      = 42;        // [20:1:48]
// Height of the handlebar fan above the top of the steering column, mm
bar_fan_h  = 20;        // [10:1:32]
// Width of the hole through the handlebar fan, mm. 0 leaves it solid.
bar_hole_w = 15;        // [0:1:30]
// Height of that hole, mm
bar_hole_h = 13;        // [4:1:24]
// Diameter of the frame tubes, mm
tube_d     = 8;         // [5:0.5:14]

/* [Rider] */
// X position of the rider's two foot studs, mm
rider_x      = 32; // [16:1:40]
// Height of the rider's footrest platform above the ground, mm
rider_z      = 22; // [14:1:36]
// Length of the footrest platform (X), mm
rider_len    = 16; // [8:0.5:20]
// Width of the footrest platform (Y), mm
rider_w      = 34; // [18:1:44]
// Thickness of the wall the DUPLO figure straddles, mm
rider_wall_t = 4;  // [2:0.5:9]
// Height of that wall above the footrests, mm
rider_wall_h = 11; // [6:0.5:22]

/* [Rear rack] */
// Add a rack over the back wheel with two studs, for luggage or a passenger
rear_rack = true;
// X position of the centre of the rack, mm
rack_x    = 0;       // [-8:1:14]
// Height of the rack's top surface above the ground, mm
rack_z    = 48;      // [30:1:52]
// Length of the rack (X), mm
rack_len  = 32;      // [32:1:48]
// Width of the rack (Y), mm
rack_w    = 18;      // [12:1:28]
// Thickness of the rack platform, mm
rack_t    = 3;       // [2:0.5:6]
// How far in from each end of the rack its side plates meet the fork, mm
rack_base_inset = 9; // [4:0.5:14]

/* [Wheels] */
// Wheel outside diameter, mm. Keep >= 32 so a wheel cannot pass the 31.7 mm small-parts test cylinder.
wheel_d      = 42;  // [32:1:48]
// Wheel tread width, mm
wheel_w      = 12;  // [6:0.5:14]
// Radial thickness of the tread ring, mm
tread_t      = 3.6; // [2:0.1:6]
// Diameter of the hub boss that rubs on the frame, mm
hub_d        = 13;  // [9:0.5:20]
// How far the hub boss stands proud of the tread, mm
hub_proud    = 0.6; // [0.2:0.1:2]
// Thickness of the wheel web, mm
web_t        = 2.4; // [1.6:0.2:5]
// Number of lightening holes in the web
spoke_holes  = 6;   // [0:1:12]
// Diameter of each lightening hole, mm
spoke_hole_d = 7;   // [3:0.5:9]

/* [Axle snap fit] */
// Diameter of the wheel's snap peg, mm
axle_d         = 6;   // [4:0.1:10]
// Diameter of the hole in the frame the peg snaps through, mm
axle_hole_d    = 6.3; // [4:0.1:11]
// Diameter of the retaining barb at the tip of the peg, mm. Its underside is a flat
// shelf, so once it is through the cheek the wheel cannot be pulled back off.
barb_d         = 7.6; // [5:0.1:12]
// Length of the barb's lead-in cone, mm
barb_cone_h    = 1.4; // [0.6:0.1:3]
// Cut a lightening window in each front fork leg
fork_window    = true;
// Thickness of each fork cheek, mm
cheek_t        = 4;   // [3:0.2:8]
// Axial gap between the wheel hub and each fork cheek, mm
fork_gap       = 0.3; // [0.15:0.05:1]
// How much the dropout slot narrows at its neck, so the axle snaps in and stays, mm
dropout_pinch  = 0.3; // [0:0.05:0.8]
// Height of that neck, mm. Taller = harder to press in, harder to ever come out.
dropout_neck_h = 1.6; // [0.8:0.2:4]
// Axial slack between the hub boss and the frame cheek, mm
snap_play      = 0.3; // [0.1:0.05:1]
// Width of the cross slot that lets the peg flex, mm
slot_w         = 1.2; // [0.8:0.1:2]
// How far the flex slot cuts down into the hub. Longer petals bend without cracking.
slot_depth     = 3;   // [0:0.5:6]

/* [Cargo box] */
// Height of the box walls above the floor plate, mm
box_h    = 20;        // [12:1:40]
// Box wall thickness, mm
box_wall = 2;         // [1.6:0.1:4]
// How far the box leans out toward the front wheel, bottom to rim, mm. The back wall
// stays vertical so the box can tuck right up against the handlebar.
box_flare_front = 23; // [0:0.5:34]
// How far the box flares outward left and right, bottom to rim, mm
box_flare_y     = 3;  // [0:0.5:8]
// Height of the straight collar at the top of the box the tent grips, mm
box_collar_h    = 4;  // [3:0.5:12]
// Corner rounding radius of the box, mm
box_round       = 3;  // [0:0.5:8]

/* [Rain tent] */
// Height of the tent above the box rim, mm
tent_h       = 26;       // [14:1:44]
// Tent wall thickness, mm
tent_wall    = 2;        // [1.6:0.1:4]
// How far the tent skirt reaches down over the box collar, mm. Must not exceed box_collar_h.
tent_skirt_h = 4;        // [3:0.5:12]
// Interference per side between the tent skirt and the box collar, mm. Lower = looser.
tent_grip    = 0.25;     // [0:0.05:0.6]
// How much of the box's lean the tent mirrors. 1 makes it an exact mirror: vertical at
// the back, leaning in toward the front by as much as the box leans out.
tent_mirror  = 1;        // [0:0.05:1.2]
// Width of the windows in the front and back walls, mm. 0 leaves both solid. The limit
// here is the tent's width, which is why these are narrower than the side windows.
tent_window_fb_w   = 30; // [0:1:38]
// Height of the front and back windows, mm
tent_window_fb_h   = 18; // [4:1:26]
// Width of the windows in the left and right walls, mm. 0 leaves both solid. These look
// along the length of the tent, so there is far more room for them.
tent_window_side_w = 34; // [0:1:48]
// Height of the side windows, mm
tent_window_side_h = 18; // [4:1:26]
// Height of every window's centre above the box rim, mm
tent_window_z      = 12; // [5:1:30]
// Put a cross of mullions in the middle of each side window, like a house window
tent_window_cross  = true;
// Thickness of those mullion bars, mm
tent_window_bar_t  = 2.4; // [1.6:0.1:5]

/* [Kickstand] */
// Add a kickstand stub so the bike parks leaning instead of falling flat
kickstand   = false;
// How far the kickstand foot reaches out to the left, mm
kickstand_y = 14; // [8:1:24]
// Thickness of the kickstand stub, mm
kickstand_t = 4;  // [2.5:0.5:8]
// X position of the kickstand, mm
kickstand_x = 30; // [10:1:50]

/* [Fit] */
// General printing clearance between mating parts, mm
clearance    = 0.2;       // [0:0.05:0.6]
// Resize the DUPLO studs only, to tune clutch power for your printer. 1.03 = 3% wider.
stud_rescale = 1;         // [0.94:0.01:1.08]
// Resize the length of the socket wall splines. The LEGO.scad author notes 0.3 for Bambu + PETG.
wall_splines_rescale = 1; // [0.2:0.05:1.2]

/* [Printing] */
// Chamfer on bed-facing edges (helps against elephant foot), mm
bottom_chamfer = 0.6; // [0:0.1:2]
// Gap between pieces in the "plate" layout, mm
plate_gap      = 8;   // [3:1:20]

/* [Hidden] */
$fn = $preview ? fn_preview : fn_render;
eps = 0.01;
ovr = 1; // overshoot for clean boolean cuts

// --- DUPLO geometry -------------------------------------------------
// Values mirrored from libs/LEGO.scad/LEGO.scad:309-333 (brand == "duplo").
// They are local to block(), so they cannot be read from outside.
duplo_pitch   = 16;
duplo_stud_d  = 9.4;
duplo_stud_h  = 4.5;
duplo_wall    = 1.6;
duplo_plate_h = block_height(1 / 2, "duplo"); // 9.6 mm
duplo_brick_h = block_height(1, "duplo");     // 19.2 mm
// Footprint of an n-stud DUPLO block: n * 16 - 2 * wall_play
pad_xy        = 2 * duplo_pitch - 0.2;        // 31.8 mm

// --- derived heights -----------------------------------------------
axle_z        = wheel_d / 2;
// top of the tyre above the ground; the rack has to clear this, not the axle height
wheel_top_z   = axle_z + wheel_d / 2;
beam_z0       = ground_clearance;
beam_z1       = beam_z0 + duplo_plate_h; // frame deck top / box floor bottom
deck_stud_top = beam_z1 + duplo_stud_h;

box_z0        = beam_z1;
box_floor_top = box_z0 + duplo_plate_h; // top of the box's floor plate
box_stud_top  = box_floor_top + duplo_stud_h;
box_rim_z     = box_floor_top + box_h;
box_flare_top_z = box_rim_z - box_collar_h;

box_bot_xy  = pad_xy + 2 * box_wall;
box_top_x   = box_bot_xy + box_flare_front;
box_top_y   = box_bot_xy + 2 * box_flare_y;
// The slope runs the full height of the box and only on the front face. box_shift is how
// far the top face's centre sits forward of the bottom face's centre.
box_shift   = box_flare_front / 2;
box_flare_h = box_flare_top_z - box_z0;
box_rear_x  = -box_bot_xy / 2; // vertical back wall, relative to deck_x
box_front_b = box_bot_xy / 2;  // bottom front corner
box_front_t = box_front_b + box_flare_front; // top front corner

// Fraction of the flare reached at height z, and the outer section there.
function box_t(z) = min(1, max(0, (z - box_z0) / box_flare_h));
function box_ox(z) = box_bot_xy + box_flare_front * box_t(z);
function box_oy(z) = box_bot_xy + 2 * box_flare_y * box_t(z);
function box_cx(z) = box_flare_front * box_t(z) / 2;

// Perpendicular distance from the front wheel's centre to the box's sloped front face.
// The box is meant to overhang the wheel, so this replaces a plain horizontal clearance.
front_face_d =
    abs(box_flare_front * (axle_z - box_z0) - box_flare_h * (wheelbase - deck_x - box_front_b)) /
        norm([box_flare_front, box_flare_h]);

tent_z0    = box_rim_z - tent_skirt_h;
tent_top_z = box_rim_z + tent_h;
tent_out_x = box_top_x + 2 * tent_wall;
tent_out_y = box_top_y + 2 * tent_wall;

// The tent mirrors the box: the back wall is vertical and the front wall leans IN by as
// much as the box leans OUT, so the two read as one diamond.
tent_lean_x = box_flare_front * tent_mirror;
tent_lean_y = 2 * box_flare_y * tent_mirror;
tent_roof_x = tent_out_x - tent_lean_x;
tent_roof_y = tent_out_y - tent_lean_y;

// Outer section of the tent at height z above the box rim. The back wall is vertical, so
// only the front edge moves; tent_cx is how far back the section's centre has travelled.
function tent_sx(z) = tent_out_x - tent_lean_x * z / tent_h;
function tent_cx(z) = -tent_lean_x * z / (2 * tent_h);
function tent_sy(z) = tent_out_y - tent_lean_y * z / tent_h;

// Minimum wall left beside and above a window, mm. Below this the corner is too fragile
// to survive a toddler and, printed roof-down, too narrow to anchor the window's bridge.
win_wall_min = 4;
// A side window is a rectangle in a leaning trapezoid, so it is centred on the section
// at its own top edge -- the narrowest part of the wall it has to fit inside.
win_top_z    = tent_window_z + tent_window_side_h / 2;
win_side_cx  = tent_cx(win_top_z);

// --- wheel / axle derived -------------------------------------------
hub_h      = wheel_w + hub_proud;
peg_barb_z = cheek_t + snap_play; // barb underside, measured from the hub top
peg_len    = peg_barb_z + barb_cone_h;
peg_top    = hub_h + peg_len; // absolute tip height, for the echo
spoke_r    = (hub_d / 2 + (wheel_d / 2 - tread_t)) / 2;

// Symmetric fork: a cheek each side of the wheel, which is centred on the bike midplane.
// Only the right-hand cheek is drilled; the left one is a tilt stop.
fork_y0 = wheel_w / 2 + hub_proud + fork_gap;
fork_y1 = fork_y0 + cheek_t;
fork_yc = (fork_y0 + fork_y1) / 2;
boss_d  = axle_hole_d + 2 * 3.2;

// How far each fork plate reaches out past its axle, and so the half-width of the arch
// it throws over that axle, mm. Also what sets the printed length of the frame.
fork_tail = 8;

// Handlebar grips: a little fatter than the bar itself, so they are what the box and
// tent have to clear, not the tube.
grip_d = tube_d * 1.15;

beam_x0 = ceil(wheel_d / 2) + 2;
beam_x1 = wheelbase - ceil(wheel_d / 2) - 1;

// printed extents of the frame, used by the print-plate layout
// The rack reaches further back than the fork does once rack_len grows, so it, not the
// wheel, can set the rear end of the printed frame.
frame_x_min  = min(-fork_tail, rear_rack ? rack_x - rack_len / 2 : -fork_tail);
frame_x_max  = wheelbase + fork_tail;
frame_y_half = max(beam_w / 2, fork_y1, bar_w / 2, rider_w / 2, rack_w / 2, kickstand ? kickstand_y : 0);

// print plate: frame on row 1, then two wheels, the box and the tent on row 2
plate_w = max(frame_x_max - frame_x_min, 2 * wheel_d + box_top_x + tent_out_x + 3 * plate_gap);
plate_d = 2 * frame_y_half + plate_gap + max(wheel_d, box_top_y, tent_out_y);

// --- validation -----------------------------------------------------
assert(
    wheel_d >= 32,
    "wheel_d must be >= 32 mm: a smaller wheel fits the 31.7 mm small-parts test cylinder and is a choking hazard for under-3s"
);
assert(box_wall >= 0.9, "box_wall must be >= 0.9 mm (2 extrusion lines at 0.45 mm)");
assert(tent_wall >= 0.9, "tent_wall must be >= 0.9 mm (2 extrusion lines at 0.45 mm)");
assert(
    box_bot_xy - 2 * box_wall >= pad_xy - 1,
    "cargo box interior is narrower than a 2x2 DUPLO brick: reduce box_wall"
);
assert(box_h > box_collar_h + 4, "box_h must leave room for the flare below the collar");
assert(axle_hole_d > axle_d, "axle_hole_d must be larger than axle_d so the wheel can spin");
assert(barb_d > axle_hole_d + 0.4, "barb_d must exceed axle_hole_d or the wheel will not stay on");
assert(barb_d < hub_d, "barb_d must be smaller than hub_d");
assert(slot_depth < hub_h - web_t, "slot_depth must not cut through the wheel web");
assert(fork_y0 > wheel_w / 2 + hub_proud, "the fork cheeks would foul the wheel hub: raise fork_gap");
assert(dropout_pinch > 0.1, "dropout_pinch must bite, or the wheel will fall back out of the slot");
assert(dropout_pinch < axle_d / 4, "dropout_pinch is so deep the axle cannot be pressed past the neck");
assert(axle_z - axle_hole_d / 2 - dropout_neck_h > beam_z0, "no room below the axle for the dropout neck");
assert(axle_z > ground_clearance, "wheel radius must exceed ground_clearance");
assert(deck_x + box_rear_x > wheel_d / 2 + 2, "cargo box overlaps the rear wheel: increase deck_x");
assert(
    front_face_d > wheel_d / 2 + 1,
    "the box front face cuts into the front wheel: reduce box_flare_front or deck_x"
);
assert(
    deck_x + box_rear_x - tent_wall > bar_x + grip_d / 2 + 1,
    "the box/tent back wall hits the handlebar: raise deck_x or lower bar_x"
);
assert(deck_x - pad_xy / 2 > beam_x0 && deck_x + pad_xy / 2 < beam_x1, "the 2x2 deck must sit within the frame beam");
assert(beam_x1 > beam_x0 + pad_xy, "wheelbase is too short for the frame beam");
assert(rider_wall_t < duplo_pitch - duplo_stud_d, "rider_wall_t is too thick to fit between the two foot studs");
assert(rider_z > beam_z1, "rider_z must be above the top of the beam");
assert(
    rider_x - rider_len / 2 > wheel_d / 2 + 1,
    "the rider's footrest would foul the rear wheel: raise rider_x or shorten rider_len"
);
assert(!rear_rack || rack_z - rack_t > wheel_top_z + 1, "the rear rack would foul the back wheel: raise rack_z");
assert(!rear_rack || rack_len >= 2 * duplo_pitch, "rack_len must be at least two DUPLO pitches to carry its two studs");
assert(!rear_rack || rack_w >= duplo_pitch, "rack_w is too narrow for a DUPLO piece");
assert(!rear_rack || rack_base_inset < rack_len / 2 - 2, "rack_base_inset is too large for rack_len");
assert(!rear_rack || rack_w / 2 <= fork_y1, "the rack platform overhangs its stays: reduce rack_w");
assert(
    !rear_rack || rack_x + rack_len / 2 < rider_x - rider_len / 2,
    "the rear rack runs into the rider's footrest: lower rack_x or rack_len"
);
assert(
    tent_window_fb_w <= tent_sy(tent_window_z + tent_window_fb_h / 2) - 2 * win_wall_min,
    "tent_window_fb_w leaves under 4 mm of wall beside it: narrow it or lower tent_window_z"
);
assert(
    tent_window_side_w <= tent_sx(win_top_z) - 2 * win_wall_min,
    "tent_window_side_w leaves under 4 mm of wall at the leaning front corner: narrow it, lower tent_window_z or raise tent_h"
);
assert(
    tent_window_fb_w / 2 <= tent_out_y / 2 - tent_wall - win_wall_min,
    "tent_window_fb_w runs into the side walls: narrow it"
);
assert(
    tent_window_z - max(tent_window_fb_h, tent_window_side_h) / 2 > 2,
    "tent windows would run into the box rim: raise tent_window_z"
);
assert(
    tent_window_z + max(tent_window_fb_h, tent_window_side_h) / 2 < tent_h - tent_wall - 2,
    "tent windows would run into the roof: lower tent_window_z or the window heights"
);
assert(
    !tent_window_cross ||
        tent_window_side_w == 0 ||
        tent_window_bar_t + 2 * win_wall_min < min(tent_window_side_w, tent_window_side_h),
    "tent_window_bar_t is too thick for the side windows: there would be no glass left around the cross"
);
assert(
    tent_skirt_h <= box_collar_h,
    "tent_skirt_h must not exceed box_collar_h, or the skirt binds on the flare below it"
);
assert(
    box_flare_front <= box_flare_h,
    "the box front face leans out past 45 degrees and will not print: raise box_h or lower box_flare_front"
);
assert(
    plate_w <= 325 && plate_d <= 320,
    "the print plate does not fit the build volume: export the pieces one at a time with -D part=..."
);

echo(
    str(
        "envelope  L x W x H = ",
        wheelbase + wheel_d,
        " x ",
        2 * frame_y_half,
        " x ",
        tent_top_z
    )
);
echo(str("print plate ", plate_w, " x ", plate_d, " mm (build volume is 325 x 320)"));
echo(str("box interior at the studs = ", box_bot_xy - 2 * box_wall, " mm (a 2x2 DUPLO brick needs ", pad_xy, ")"));
echo(str("deck studs ", beam_z1, " -> ", deck_stud_top, " mm; box socket cavity is ", duplo_plate_h - 1, " mm deep"));
echo(
    str(
        "peg: hub top ",
        hub_h,
        " barb at ",
        hub_h + peg_barb_z,
        " tip ",
        peg_top,
        " mm; fork cheeks at +/-",
        fork_y0,
        " -> +/-",
        fork_y1
    )
);
echo(str("snap: petal length ", slot_depth + peg_barb_z, " mm must flex ", (barb_d - axle_hole_d) / 2, " mm per side"));
echo(
    str(
        "dropout: neck ",
        axle_d - dropout_pinch,
        " mm vs axle ",
        axle_d,
        " mm -> press past ",
        dropout_pinch / 2,
        " mm per side"
    )
);
echo(
    str(
        "rider: foot studs ",
        duplo_pitch,
        " mm apart at z=",
        rider_z,
        ", straddle wall ",
        rider_wall_t,
        " mm thick in a ",
        duplo_pitch - duplo_stud_d,
        " mm gap"
    )
);
echo(
    str(
        "rack: two studs at x=",
        rack_x - duplo_pitch / 2,
        " and ",
        rack_x + duplo_pitch / 2,
        ", platform clears the rear tyre by ",
        rack_z - rack_t - wheel_top_z,
        " mm"
    )
);
echo(
    str(
        "tent windows: front/back ",
        tent_window_fb_w,
        " x ",
        tent_window_fb_h,
        " (max ",
        tent_sy(tent_window_z + tent_window_fb_h / 2) - 2 * win_wall_min,
        "), sides ",
        tent_window_side_w,
        " x ",
        tent_window_side_h,
        " (max ",
        tent_sx(win_top_z) - 2 * win_wall_min,
        ")"
    )
);
echo(
    str(
        "tent headroom above the box floor = ",
        box_rim_z + tent_h - tent_wall - box_floor_top,
        " mm (a DUPLO figure is about 40 mm tall)"
    )
);

// =====================================================================
//  DUPLO interfaces — generated by LEGO.scad
// =====================================================================

// A 2x2 DUPLO plate. open = sockets underneath (clicks onto studs),
// closed = solid body (used as the frame deck).
module duplo_plate_2x2(bottom = "open") {
    block(
        width = 2,
        length = 2,
        height = 1 / 2,
        brand = "duplo",
        stud_type = "hollow",
        block_bottom_type = bottom,
        reinforcement = true,
        include_wall_splines = true,
        wall_splines_rescale = wall_splines_rescale,
        stud_rescale = stud_rescale,
        $fs = $preview ? 0.6 : 0.2,
        $fa = $preview ? 6 : 2
    );
}

// =====================================================================
//  Wheel  (print orientation: axis = Z, tread on the bed, peg up)
// =====================================================================

// Shaft, flat retaining shelf, lead-in cone. The flex slot is cut in wheel(),
// so that it can run on down into the hub and give the petals room to bend.
module snap_peg() {
    cyl(d = axle_d, h = peg_barb_z, anchor = BOTTOM);
    up(peg_barb_z) cyl(d1 = barb_d, d2 = axle_d, h = barb_cone_h, anchor = BOTTOM);
}

module wheel() {
    difference() {
        union() {
            // tread ring
            difference() {
                cyl(d = wheel_d, h = wheel_w, chamfer = bottom_chamfer, anchor = BOTTOM);
                cyl(d = wheel_d - 2 * tread_t, h = wheel_w + ovr, anchor = BOTTOM, $fn = $fn);
            }
            // web, overlapping into the ring
            cyl(d = wheel_d - 2 * tread_t + 1, h = web_t, chamfer1 = bottom_chamfer, anchor = BOTTOM);
            // hub boss
            cyl(d = hub_d, h = hub_h, chamfer2 = 0.6, anchor = BOTTOM);
            // snap peg
            up(hub_h - eps)
                snap_peg();
        }
        // lightening holes
        if (spoke_holes > 0)
            zrot_copies(n = spoke_holes)
                right(spoke_r)
                    cyl(d = spoke_hole_d, h = web_t + ovr, anchor = BOTTOM, chamfer = 0.4);
        // cross slot: four petals, rooted slot_depth down inside the hub
        up(hub_h - slot_depth)
            for (a = [0, 90])
                zrot(a)
                    cuboid([slot_w, barb_d + ovr, slot_depth + peg_len + ovr], anchor = BOTTOM);
    }
}

// =====================================================================
//  Frame  (modelled in ride position; translated down for printing)
// =====================================================================

// A frame tube: a capsule between two [x, z] points, beam_width wide in Y.
module member(p1, p2, d, w) {
    hull() {
        translate([p1[0], 0, p1[1]]) ycyl(d = d, l = w);
        translate([p2[0], 0, p2[1]]) ycyl(d = d, l = w);
    }
}

// A flat plate in the X/Z plane, extruded in Y, with rounded corners.
module xz_plate(pts, r, yc, t) {
    translate([0, yc, 0])
        xrot(90)
            linear_extrude(height = t, center = true)
                polygon(round_corners(pts, radius = r, closed = true, $fn = 16));
}

// The 2x2 stud deck, trimmed to a 45-degree flare so it prints unsupported.
module frame_deck() {
    intersection() {
        union() {
            up(beam_z0) duplo_plate_2x2("closed");
            // guarantee a solid body under the studs
            up(beam_z0)
                cuboid([pad_xy, pad_xy, duplo_plate_h], anchor = BOTTOM);
        }
        union() {
            up(beam_z0)
                prismoid(size1 = [pad_xy, beam_w], size2 = [pad_xy, pad_xy], h = duplo_plate_h, anchor = BOTTOM);
            up(beam_z1 - eps) cuboid([pad_xy, pad_xy, duplo_stud_h + ovr], anchor = BOTTOM);
        }
    }
}

// A single DUPLO stud on its own. Sliced off a 1x1 plate rather than modelled by hand,
// so its diameter, height, top rounding and stud_rescale all come from LEGO.scad.
module duplo_stud() {
    down(duplo_plate_h) intersection() {
        block(
            width = 1,
            length = 1,
            height = 1 / 2,
            brand = "duplo",
            stud_type = "hollow",
            block_bottom_type = "closed",
            reinforcement = true,
            wall_splines_rescale = wall_splines_rescale,
            stud_rescale = stud_rescale,
            $fs = $preview ? 0.6 : 0.2,
            $fa = $preview ? 6 : 2
        );
        up(duplo_plate_h) cuboid([duplo_pitch, duplo_pitch, duplo_stud_h + ovr], anchor = BOTTOM);
    }
}

// Where the rider stands: a footrest each side carrying one DUPLO stud, with a low
// rounded wall down the middle for the figure to straddle. The studs are one DUPLO
// pitch apart, so a figure's two feet clip straight onto them.
module rider_stand() {
    // platform, flaring out from the beam at well under 45 degrees
    translate([rider_x, 0, beam_z0])
        prismoid(
            size1 = [rider_len, beam_w - 0.4],
            size2 = [rider_len, rider_w],
            h = rider_z - beam_z0,
            rounding = 2,
            anchor = BOTTOM
        );
    // one stud per foot
    ycopies(n = 2, spacing = duplo_pitch)
        translate([rider_x, 0, rider_z - eps])
            duplo_stud();
    // the wall that goes between the figure's legs
    hull() {
        translate([rider_x, 0, rider_z - eps]) cuboid([rider_len, rider_wall_t, eps], anchor = BOTTOM);
        translate([rider_x, 0, rider_z + rider_wall_h - rider_wall_t / 2]) xcyl(d = rider_wall_t, l = rider_len * 0.75);
    }
}

// Rack over the back wheel carrying TWO studs in line with the frame, so a 2x1 DUPLO
// piece sits on it. A side plate in each cheek plane carries it: narrow where it meets
// the rear fork and flaring outward going up, which both matches a real rack's stays and
// keeps every overhang well under 45 degrees, so the platform can reach out past the
// fork at each end without support. The plates are clear of the tyre in Y; the platform
// bridges the gap between them.
module rear_rack_assembly() {
    base_f = rack_x + rack_len / 2 - rack_base_inset;
    base_r = rack_x - rack_len / 2 + rack_base_inset;
    base_z = axle_z + 2; // above the dropout slot, so cutting it leaves the plate whole
    yflip_copy() difference() {
        xz_plate(
            [
                [base_r, base_z], [base_f, base_z],
                [rack_x + rack_len / 2, rack_z], [rack_x - rack_len / 2, rack_z]
            ],
            3,
            fork_yc,
            cheek_t
        );
        // lightening window, apex up so its ceiling is two steep slopes
        if (fork_window)
            xz_plate(
                [
                    [rack_x - 7, base_z + 4], [rack_x + 7, base_z + 4],
                    [rack_x, rack_z - rack_t - 2]
                ],
                2,
                fork_yc,
                cheek_t + ovr * 2
            );
    }
    translate([rack_x, 0, rack_z - rack_t])
        cuboid([rack_len, rack_w, rack_t], rounding = 2, edges = "Z", anchor = BOTTOM);
    xcopies(n = 2, spacing = duplo_pitch) translate([rack_x, 0, rack_z - eps]) duplo_stud();
}

module frame() {
    union() {
        // --- main beam, flat on the bed ---------------------------------
        translate([(beam_x0 + beam_x1) / 2, 0, beam_z0])
            cuboid(
                [beam_x1 - beam_x0, beam_w, duplo_plate_h],
                chamfer = bottom_chamfer,
                edges = BOTTOM,
                anchor = BOTTOM
            );

        // --- 2x2 cargo-box deck ----------------------------------------
        right(deck_x)
            frame_deck();

        // --- where the rider stands ------------------------------------
        rider_stand();

        // --- rack over the back wheel ----------------------------------
        if (rear_rack)
            rear_rack_assembly();

        // --- steering column + handlebar -------------------------------
        member([bar_x + 3, beam_z0 + tube_d / 2], [bar_x, bar_z - bar_fan_h], tube_d, beam_w * 0.7);
        // fan from the steering column out to the bar, with a hole through the middle
        // so it reads as two arms. The hole's apex points up, so its ceiling is two
        // slopes steeper than 45 degrees and it prints unsupported.
        difference() {
            hull() {
                translate([bar_x, 0, bar_z - bar_fan_h]) ycyl(d = tube_d, l = beam_w * 0.7);
                translate([bar_x, 0, bar_z]) ycyl(d = tube_d * 0.8, l = bar_w);
            }
            if (bar_hole_w > 0) hull() {
                translate([bar_x, 0, bar_z - 3.5]) xcyl(d = 3, l = tube_d * 4);
                ycopies(n = 2, spacing = bar_hole_w)
                    translate([bar_x, 0, bar_z - 3.5 - bar_hole_h])
                        xcyl(d = 3, l = tube_d * 4);
            }
        }
        // grips
        translate([bar_x, 0, bar_z])
            ycopies(n = 2, spacing = bar_w - 4)
                ycyl(d = grip_d, l = 4, rounding = 1);

        // --- wheel forks: one cheek each side, mirrored about the midplane ---
        yflip_copy() {
            // Rear: the same slim leg as the front -- a low run along the beam, a
            // foot wide enough to straddle the dropout, and a lightening window.
            difference() {
                xz_plate(
                    [
                        [-fork_tail, beam_z0], [beam_x0 + 6, beam_z0],
                        [beam_x0 + 6, beam_z1], [12, beam_z1],
                        [fork_tail, axle_z + 3], [0, axle_z + 7], [-fork_tail, axle_z + 3]
                    ],
                    3,
                    fork_yc,
                    cheek_t
                );
                if (fork_window) xz_plate(
                    [
                        [12, beam_z0 + 1.5], [23, beam_z0 + 1.5],
                        [17.5, beam_z0 + 7.5]
                    ],
                    1.5,
                    fork_yc,
                    cheek_t + ovr * 2
                );
            }
            // Front: a slim fork leg. The tall slab that used to rise alongside the
            // box is gone, so the box can lean out over the wheel; what is left is a
            // bed-contact foot wide enough to straddle the dropout slot, plus a low
            // run back along the beam.
            difference() {
                xz_plate(
                    [
                        [beam_x1 - 6, beam_z0], [wheelbase + fork_tail, beam_z0],
                        [wheelbase + fork_tail, axle_z + 3], [wheelbase, axle_z + 7],
                        [wheelbase - fork_tail, axle_z + 3], [wheelbase - 12, beam_z1],
                        [beam_x1 - 6, beam_z1]
                    ],
                    3,
                    fork_yc,
                    cheek_t
                );
                // lightening window; apex up so its ceiling is two 45-degree slopes
                if (fork_window)
                    xz_plate(
                        [
                            [wheelbase - 18, beam_z0 + 1.5], [wheelbase - 7, beam_z0 + 1.5],
                            [wheelbase - 12.5, beam_z0 + 7.5]
                        ],
                        1.5,
                        fork_yc,
                        cheek_t + ovr * 2
                    );
            }
            // axle bosses
            for (x = [0, wheelbase])
                translate([x, fork_yc, axle_z])
                    ycyl(d = boss_d, l = cheek_t);
        }

        // --- kickstand --------------------------------------------------
        if (kickstand)
            hull() {
                translate([kickstand_x, -beam_w / 2 + 1, beam_z0 + duplo_plate_h - 1])
                    cuboid([kickstand_t * 2, 2, 2], anchor = CENTER);
                translate([kickstand_x, -kickstand_y, beam_z0])
                    cuboid([kickstand_t * 1.6, 4, 2.5], chamfer = bottom_chamfer, edges = BOTTOM, anchor = BOTTOM);
            }
    }
}

// A bicycle dropout: the axle hole, a neck just below it that is deliberately NARROWER
// than the axle, and a lead-in slot running down out of the bottom edge of the cheek.
// The wheel is fed up into the fork from below and the axle is pressed past the neck,
// after which it cannot drop back out; the bike's own weight seats it in the hole.
// Only the right-hand cheek is cut -- the left one stays solid and limits wheel tilt.
module dropout() {
    neck_w   = axle_d - dropout_pinch; // narrower than the axle on purpose
    neck_top = axle_z - axle_hole_d / 2;
    neck_bot = neck_top - dropout_neck_h;
    slot_bot = beam_z0 - ovr; // open at the bottom edge of the cheek
    t        = cheek_t + ovr * 2;
    translate([0, fork_yc, 0]) {
        // the axle hole itself
        up(axle_z)
            ycyl(d = axle_hole_d, l = t, chamfer = 0.5);
        // the neck the axle has to be pressed through
        up((neck_top + neck_bot) / 2)
            cuboid(
                [neck_w, t, dropout_neck_h],
                rounding = min(neck_w, dropout_neck_h) / 2 - 0.01,
                edges = "Y"
            );
        // lead-in slot below the neck, open at the bottom
        up((neck_bot + slot_bot) / 2)
            cuboid([axle_hole_d, t, neck_bot - slot_bot], anchor = CENTER);
    }
}

// frame + the dropouts the wheels snap into
module frame_part() {
    difference() {
        frame();
        for (x = [0, wheelbase]) right(x) dropout();
    }
}

// =====================================================================
//  Cargo box  (modelled in ride position; floor plate from LEGO.scad)
// =====================================================================

// One horizontal slice of the box shell between two heights. inset1/inset2 pull the
// section in from the outer surface, which is how the interior and the under-floor
// hollow are cut. The back wall is vertical; only the front leans out.
module box_section(z0, z1, inset1 = 0, inset2 = undef) {
    i2 = is_undef(inset2) ? inset1 : inset2;
    up(z0)
        right(box_cx(z0))
            prismoid(
                size1 = [box_ox(z0) - 2 * inset1, box_oy(z0) - 2 * inset1],
                size2 = [box_ox(z1) - 2 * i2, box_oy(z1) - 2 * i2],
                shift = [box_cx(z1) - box_cx(z0), 0],
                h = z1 - z0,
                rounding = max(0.1, box_round - min(inset1, i2)),
                anchor = BOTTOM
            );
}

module cargo_box() {
    // leave a floor slab between the interior and the hollow under it
    under_top = box_floor_top - box_wall;
    difference() {
        union() {
            // Chamfer on the bed-facing edge, then the sloped shell, then the straight
            // collar. These must be separate sections: a prismoid interpolates linearly,
            // so one call spanning both would leave the collar tapered and the tent
            // would have nothing parallel to grip.
            box_section(box_z0, box_z0 + bottom_chamfer, bottom_chamfer, 0);
            box_section(box_z0 + bottom_chamfer, box_flare_top_z);
            box_section(box_flare_top_z - eps, box_rim_z);
        }
        // the interior, with its floor at box_floor_top across the whole footprint
        box_section(box_floor_top, box_flare_top_z, box_wall);
        box_section(box_flare_top_z - eps, box_rim_z + ovr, box_wall);
        // hollow out the skirt under the floor, leaving the DUPLO plate's seat
        box_section(box_z0 - ovr, under_top, box_wall + 0.4);
        // rim chamfer
        up(box_rim_z - 0.8)
            right(box_shift)
                rect_tube(
                    size = [box_top_x + ovr, box_top_y + ovr],
                    isize1 = [box_top_x - 2 * box_wall, box_top_y - 2 * box_wall],
                    isize2 = [box_top_x - 2 * box_wall + 1.6, box_top_y - 2 * box_wall + 1.6],
                    h = 0.8 + eps,
                    anchor = BOTTOM
                );
    }
    // --- floor: a real 2x2 DUPLO plate, sockets down, studs up inside --
    up(box_z0)
        duplo_plate_2x2("open");
}

// =====================================================================
//  Rain tent  (modelled in ride position; flipped for printing)
// =====================================================================

// The tent mirrors the cargo box: vertical at the back so it stays clear of the
// handlebar, leaning IN toward the front by as much as the box leans out. Printed
// roof-down that lean becomes an overhang of atan(box_flare_front / tent_h) from
// vertical, which is why tent_h has to stay large enough to keep it under 45 degrees.
module tent_shell() {
    difference() {
        union() {
            // skirt band that grips the box collar
            up(tent_z0)
                cuboid(
                    [tent_out_x, tent_out_y, tent_skirt_h + eps],
                    rounding = box_round + tent_wall,
                    edges = "Z",
                    anchor = BOTTOM
                );
            // canopy, leaning in toward the front with the back wall vertical
            up(box_rim_z - eps)
                prismoid(
                    size1 = [tent_out_x, tent_out_y],
                    size2 = [tent_roof_x, tent_roof_y],
                    shift = [-tent_lean_x / 2, 0],
                    h = tent_h + eps,
                    rounding = box_round + tent_wall,
                    anchor = BOTTOM
                );
        }
        // skirt bore: a press fit on the box collar
        up(tent_z0 - ovr)
            cuboid(
                [box_top_x - 2 * tent_grip, box_top_y - 2 * tent_grip, tent_skirt_h + ovr],
                rounding = box_round,
                edges = "Z",
                anchor = BOTTOM
            );
        // canopy cavity
        up(box_rim_z - eps)
            prismoid(
                size1 = [tent_out_x - 2 * tent_wall, tent_out_y - 2 * tent_wall],
                size2 = [tent_roof_x - 2 * tent_wall, tent_roof_y - 2 * tent_wall],
                shift = [-tent_lean_x / 2, 0],
                h = tent_h - tent_wall,
                rounding = box_round,
                anchor = BOTTOM
            );
    }
}

// One window per side, as two prisms: each runs clean through the tent and so cuts the
// wall at both ends. The two pairs are sized separately because they are limited by
// different things -- the front and back by the tent's width, the sides by its much
// greater length. Printed roof-down a window's lower edge becomes a bridge across its
// own width, which is why the corners are rounded hard and the mullions help.
module tent_window_cuts() {
    up(box_rim_z + tent_window_z) {
        // left and right, with the mullion cross left standing inside them
        if (tent_window_side_w > 0)
            right(win_side_cx) difference() {
                cuboid(
                    [tent_window_side_w, tent_out_y + ovr, tent_window_side_h],
                    rounding = min(tent_window_side_w, tent_window_side_h) / 3,
                    edges = "Y"
                );
                // The bars span the full width of the tent, so what survives the cut is
                // exactly the wall thickness in each side wall. They stop short of the
                // front and back walls, so those windows stay clear panes.
                if (tent_window_cross) {
                    cuboid([tent_window_bar_t, tent_out_y + ovr, tent_window_side_h]);
                    cuboid([tent_window_side_w, tent_out_y + ovr, tent_window_bar_t]);
                }
            }
        // front and back
        if (tent_window_fb_w > 0)
            right(tent_cx(tent_window_z))
                cuboid(
                    [tent_out_x + ovr, tent_window_fb_w, tent_window_fb_h],
                    rounding = min(tent_window_fb_w, tent_window_fb_h) / 3,
                    edges = "X"
                );
    }
}

module rain_tent() {
    difference() {
        tent_shell();
        tent_window_cuts();
    }
}

// =====================================================================
//  Placement
// =====================================================================

module wheel_in_place(x) {
    translate([x, -wheel_w / 2, axle_z]) xrot(-90) wheel();
}

module assembled() {
    color("MediumSeaGreen") frame_part();
    right(deck_x) color("Khaki") cargo_box();
    right(deck_x + box_shift) color("IndianRed") rain_tent();
    color("DimGray") {
        wheel_in_place(0);
        wheel_in_place(wheelbase);
    }
}

// --- print orientations ---------------------------------------------
module frame_print() {
    down(beam_z0) frame_part();
}
module box_print() {
    down(box_z0) cargo_box();
}
module tent_print() {
    up(tent_top_z) xrot(180) rain_tent();
}
module wheel_print() {
    wheel();
}

module print_plate() {
    row2 = frame_y_half + plate_gap;
    x0   = -(frame_x_max - frame_x_min) / 2;
    // laid out left to right, each one clear of the last by plate_gap
    wx1  = x0 + wheel_d / 2;
    wx2  = wx1 + wheel_d + plate_gap;
    bx   = wx2 + wheel_d / 2 + plate_gap + box_top_x / 2;
    tx   = bx + box_top_x / 2 + plate_gap + tent_out_x / 2;

    translate([-(frame_x_min + frame_x_max) / 2, 0, 0]) frame_print();
    translate([wx1, row2 + wheel_d / 2, 0]) wheel_print();
    translate([wx2, row2 + wheel_d / 2, 0]) wheel_print();
    // the box is not centred on its own origin: its top face is shifted forward by
    // box_shift, so offset it to centre its footprint on bx
    translate([bx - box_shift, row2 + box_top_y / 2, 0])
        box_print();
    translate([tx, row2 + tent_out_y / 2, 0]) tent_print();
}

if (part == "assembled") assembled();
else if (part == "plate") print_plate();
else if (part == "frame") frame_print();
else if (part == "box") box_print();
else if (part == "tent") tent_print();
else if (part == "wheel") wheel_print();
else assert(false, str("unknown part: ", part));
